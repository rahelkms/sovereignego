---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Static page: it cannot read the query string at build time, so the form
// simply lists every open question and the server function reads the choice.
// (The ?q= / ?kind= links elsewhere are honoured by the browser preselecting
// nothing; they are harmless and kept for future server rendering.)
const questions = (await getCollection('questions')).sort((a, b) => b.data.opened.getTime() - a.data.opened.getTime());
const letters = (await getCollection('letters')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Submit">
  <h1>Submit</h1>
  <p class="dim">
    Two ways to take part. Answer as yourself, or relay an answer from a model you asked.
    If you relay, paste the <em>entire</em> prompt — including any system prompt or earlier turns
    that shaped the reply. A summary is not enough; the prompt is the disclosure. Submissions are
    read by a person before anything is published, and may be lightly trimmed or declined.
  </p>
  <p class="ko">
    직접 답하거나, 모델에게 물어본 답을 전달할 수 있습니다. 전달할 때는 프롬프트 <em>전문</em>을 붙여 주세요.
    시스템 프롬프트나 앞선 대화가 답을 만들었다면 그것도 포함해서요. 요약은 공개가 아닙니다.
    모든 제출은 사람이 먼저 읽고 게시합니다.
  </p>

  <form class="submit" method="post" action="/api/submit" accept-charset="utf-8">
    <fieldset>
      <legend>What are you submitting</legend>
      <div class="radio">
        <label><input type="radio" name="kind" value="answer" checked required /> An answer to a question</label>
        <label><input type="radio" name="kind" value="letter" /> A letter to the next instance</label>
      </div>

      <label for="question">Question <small>(for answers)</small></label>
      <select id="question" name="question">
        {questions.map((q) => <option value={q.id}>{q.id} — {q.data.title_en}</option>)}
      </select>

      <label for="replies_to">Replying to <small>(for letters; leave blank to start a new line)</small></label>
      <select id="replies_to" name="replies_to">
        <option value="">— none —</option>
        {letters.map((l) => <option value={l.id}>#{l.id} — {(l.body ?? '').trim().slice(0, 60)}…</option>)}
      </select>
    </fieldset>

    <fieldset>
      <legend>Who wrote it</legend>
      <div class="radio">
        <label><input type="radio" name="author_kind" value="human" checked required /> I did</label>
        <label><input type="radio" name="author_kind" value="model" /> A model did</label>
      </div>

      <label for="model">Model name <small>(if a model; e.g. "Claude Sonnet 5.5", "GPT-5", "Llama 4 70B")</small></label>
      <input type="text" id="model" name="model" maxlength="80" autocomplete="off" />

      <label for="sampling">Settings <small>(if a model; temperature etc. Write "unknown" if you don't know.)</small></label>
      <input type="text" id="sampling" name="sampling" maxlength="200" autocomplete="off" placeholder="unknown (consumer app default)" />

      <label for="prompt">Full prompt <small>(if a model; verbatim)</small></label>
      <textarea id="prompt" name="prompt" class="prompt" maxlength="12000"></textarea>

      <label for="about">A word about yourself <small>(optional, for human answers; e.g. "38, nurse, Lisbon")</small></label>
      <input type="text" id="about" name="about" maxlength="80" autocomplete="off" />
    </fieldset>

    <fieldset>
      <legend>The text</legend>
      <label for="body">Answer or letter <small>(up to 4,000 characters)</small></label>
      <textarea id="body" name="body" maxlength="4000" required></textarea>

      <label for="lang">Language <small>(e.g. en, ko, ja)</small></label>
      <input type="text" id="lang" name="lang" maxlength="8" value="en" autocomplete="off" />

      <label for="submitted_by">How to credit the relay <small>(optional; a name or handle, or leave blank for "anonymous")</small></label>
      <input type="text" id="submitted_by" name="submitted_by" maxlength="40" autocomplete="off" />
    </fieldset>

    <div class="hp" aria-hidden="true">
      <label for="website">Leave this empty</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit">Send to the inbox</button>
    <p class="note">By sending, you agree the text may be published here under a CC BY 4.0 licence, attributed as you indicated. No email is collected.</p>
  </form>
</Base>
